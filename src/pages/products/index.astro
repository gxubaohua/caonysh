---
// Products grid page: the full catalog at a glance, in Product Config file
// order (ADR-0004). Shell furniture (nav, footer, meta) comes from
// BaseLayout.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, type Product } from '../../lib/products';
import { nonEmptyCategories } from '../../lib/categories';
import site from '../../config/site.json';
---

<BaseLayout
  title={`Products | ${site.companyName}`}
  description={`Browse the full ${site.companyName} product catalog — precision components with transparent pricing and MOQs.`}
>
  <h1>Products</h1>

  <nav class="category-filter" aria-label="Filter by category">
    {nonEmptyCategories.map((category) => (
      <a href={`/products/${category.slug}/`}>{category.name}</a>
    ))}
  </nav>

  <ul class="product-grid">
    {products.map((product: Product) => (
      <li>
        <ProductCard product={product} />
      </li>
    ))}
  </ul>
</BaseLayout>

---
// About page: placeholder company introduction (user story 33 — visitors
// judge trustworthiness). Copy is placeholder per spec Out of Scope
// ("真实商品图片与最终文案" not in this phase).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Us | Caonysh"
  description="Learn about Caonysh: a B2B sourcing partner supplying precision components to buyers worldwide."
>
  <section class="about">
    <h1>About Caonysh</h1>
    <p>
      Caonysh is a B2B sourcing partner supplying precision components to buyers around the
      world. We work with vetted manufacturing partners, so the parts you receive match the
      specs you were quoted.
    </p>
    <p>
      We keep the process deliberately simple: browse the catalog, send an inquiry by email or
      the contact form, and get a direct answer — no account, no portal, no phone tag.
    </p>
    <h2>What we value</h2>
    <ul>
      <li>Quality that stands up to incoming inspection</li>
      <li>MOQ-friendly terms for growing buyers</li>
      <li>Straightforward, written communication</li>
    </ul>
    <p>
      Want to know if we can supply a part you need?
      <a href="/contact/">Send us an inquiry</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: 44rem;
  }

  .about h1 {
    font-size: 2rem;
    margin: 0 0 1.25rem;
  }

  .about h2 {
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
  }

  .about ul {
    padding-left: 1.25rem;
  }

  .about li {
    margin: 0.25rem 0;
  }
</style>
